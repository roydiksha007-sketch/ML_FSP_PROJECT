   "source": [
    "# MIN-MAX NORMALISATION"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "5e47cffb-1537-425e-84fa-24e2c0c70ac2",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Original Values: [12, 25, 40, 55, 70]\n",
      "Normalized Values: [0.0, 0.22413793103448276, 0.4827586206896552, 0.7413793103448276, 1.0]\n"
     ]
    }
   ],
   "source": [
    "values = [12, 25, 40, 55, 70]\n",
    "\n",
    "xmin = min(values)\n",
    "xmax = max(values)\n",
    "\n",
    "normalized = [(x - xmin) / (xmax - xmin) for x in values]\n",
    "\n",
    "print(\"Original Values:\", values)\n",
    "print(\"Normalized Values:\", normalized)"
   ]
  },
