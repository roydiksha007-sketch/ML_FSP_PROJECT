   "source": [
    "import pandas as pd\n",
    "\n",
    "df = pd.DataFrame({\n",
    "    'City': ['Kolkata', 'Delhi', 'Mumbai', 'Chennai']\n",
    "})\n",
    "\n",
    "one_hot = pd.get_dummies(df['City'])\n",
    "\n",
    "print(one_hot)"
   ]
