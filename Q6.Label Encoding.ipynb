   "source": [
    "# Label Encoding"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "7de9aacd-8e56-4297-be5c-f6bc260beef1",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Original Data: ['Red', 'Blue', 'Green', 'Blue']\n",
      "Encoded Data: [2 0 1 0]\n"
     ]
    }
   ],
   "source": [
    "from sklearn.preprocessing import LabelEncoder\n",
    "\n",
    "colors = [\"Red\", \"Blue\", \"Green\", \"Blue\"]\n",
    "\n",
    "encoder = LabelEncoder()\n",
    "\n",
    "encoded = encoder.fit_transform(colors)\n",
    "\n",
    "print(\"Original Data:\", colors)\n",
    "print(\"Encoded Data:\", encoded)"
   ]
  },
