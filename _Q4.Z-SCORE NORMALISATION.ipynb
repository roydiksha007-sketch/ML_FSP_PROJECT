   "source": [
    "# Z-SCORE NORMALISATION"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "9eaf9fd7-8d17-4810-868c-1c308680eb78",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Mean = 30.0\n",
      "Standard Deviation = 14.142135623730951\n",
      "Z-Score Values = [-1.41421356 -0.70710678  0.          0.70710678  1.41421356]\n"
     ]
    }
   ],
   "source": [
    "import numpy as np\n",
    "\n",
    "data = np.array([10, 20, 30, 40, 50])\n",
    "\n",
    "mean = np.mean(data)\n",
    "std = np.std(data)\n",
    "\n",
    "z_scores = (data - mean) / std\n",
    "\n",
    "print(\"Mean =\", mean)\n",
    "print(\"Standard Deviation =\", std)\n",
    "print(\"Z-Score Values =\", z_scores)"
   ]
  },
