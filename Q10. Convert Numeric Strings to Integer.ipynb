   "source": [
    "# Convert Numeric Strings to Integer"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "cc2e8ef4-572b-46cf-833b-5ade7cc6e945",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Before Conversion:\n",
      "Numbers    object\n",
      "dtype: object\n",
      "\n",
      "After Conversion:\n",
      "Numbers    int64\n",
      "dtype: object\n",
      "   Numbers\n",
      "0       10\n",
      "1       20\n",
      "2       30\n",
      "3       40\n",
      "4       50\n"
     ]
    }
   ],
   "source": [
    "import pandas as pd\n",
    "\n",
    "df = pd.DataFrame({\n",
    "    'Numbers': ['10', '20', '30', '40', '50']\n",
    "})\n",
    "\n",
    "print(\"Before Conversion:\")\n",
    "print(df.dtypes)\n",
    "\n",
    "df['Numbers'] = df['Numbers'].astype(int)\n",
    "\n",
    "print(\"\\nAfter Conversion:\")\n",
    "print(df.dtypes)\n",
    "\n",
    "print(df)"
   ]
  },
