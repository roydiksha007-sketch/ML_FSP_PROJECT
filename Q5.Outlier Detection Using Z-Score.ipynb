   "source": [
    "# Outlier Detection Using Z-Score"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "298f4a5b-5464-42c2-8e98-3b38e1803103",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Z-Scores: [0.57017018 0.5079698  0.44576941 0.38356903 0.32136865 2.22884707]\n",
      "Outliers: []\n"
     ]
    }
   ],
   "source": [
    "import numpy as np\n",
    "from scipy import stats\n",
    "\n",
    "data = np.array([10, 12, 14, 16, 18, 100])\n",
    "\n",
    "z_scores = np.abs(stats.zscore(data))\n",
    "\n",
    "threshold = 3\n",
    "\n",
    "outliers = data[z_scores > threshold]\n",
    "\n",
    "print(\"Z-Scores:\", z_scores)\n",
    "print(\"Outliers:\", outliers)"
   ]
  },
